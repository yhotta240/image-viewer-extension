{
  "manifest_version": 3,
  "name": "Image Viewer",
  "short_name": "Image Viewer",
  "version": "0.0.3",
  "description": "現在のページにある画像をギャラリーとして閲覧します",
  "icons": {
    "48": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
